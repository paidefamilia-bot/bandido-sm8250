mount("ext4", "EMMC", "/dev/block/bootdevice/by-name/system", "/system");
mount("ext4", "EMMC", "/dev/block/bootdevice/by-name/vendor", "/vendor");

# Backup current boot image
ui_print("💾 Creating backup of current kernel...");
run_program("/sbin/dd", "if=/dev/block/bootdevice/by-name/boot", "of=/sdcard/boot_backup_" + getprop("ro.build.date") + ".img");
ui_print("✅ Backup saved to /sdcard/boot_backup_" + getprop("ro.build.date") + ".img");

# Flash new kernel
ui_print("");
ui_print("🧠 Installing AI-powered kernel...");
package_extract_file("boot.img", "/dev/block/bootdevice/by-name/boot");
ui_print("✅ Kernel flashed successfully!");

# Flash DTBO if present
if (file_getprop("/tmp/anykernel/dtbo.img", "size") != "") then
    ui_print("🔧 Installing device tree overlay...");
    package_extract_file("dtbo.img", "/dev/block/bootdevice/by-name/dtbo");
    ui_print("✅ DTBO flashed successfully!");
endif;

# Install AI modules
ui_print("");
ui_print("🤖 Installing AI system modules...");
package_extract_dir("modules", "/system/lib/modules");
set_perm_recursive(0, 0, 0644, 0644, "/system/lib/modules");
ui_print("✅ AI modules installed!");

# Create AI configuration directory
ui_print("⚙️  Setting up AI configuration...");
run_program("/sbin/mkdir", "-p", "/data/ai_scheduler");
run_program("/sbin/chmod", "755", "/data/ai_scheduler");

# Install AI configuration files
package_extract_dir("ai_config", "/data/ai_scheduler");
set_perm_recursive(0, 0, 0644, 0644, "/data/ai_scheduler");

# Set up AI system defaults
ui_print("🎯 Configuring AI system defaults...");
write_raw_image("/tmp/ai_defaults.conf", "/data/ai_scheduler/defaults.conf");

# Unmount partitions
unmount("/system");
unmount("/vendor");

