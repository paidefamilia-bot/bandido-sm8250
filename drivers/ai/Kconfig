# AI Subsystem Configuration
# Copyright (C) 2024 Bandido Kernel Team

menuconfig AI_SUBSYSTEM
	bool "Artificial Intelligence Subsystem"
	depends on SMP && !PREEMPT_RT
	help
	  Enable the AI subsystem for intelligent kernel optimizations.
	  This includes AI-powered scheduling, power management, and
	  performance optimization features.

	  The AI subsystem uses lightweight machine learning algorithms
	  to learn from system behavior and optimize performance
	  automatically.

	  If unsure, say Y.

if AI_SUBSYSTEM

config AI_SCHEDULER
	tristate "AI-Powered Task Scheduler"
	depends on AI_SUBSYSTEM
	default y
	help
	  Enable AI-powered task scheduling that learns from task
	  behavior patterns to optimize CPU allocation and performance.

	  The AI scheduler uses machine learning to:
	  - Classify tasks by type (gaming, interactive, background, etc.)
	  - Predict optimal CPU placement
	  - Optimize performance vs power consumption
	  - Learn from user interaction patterns

	  This can significantly improve system responsiveness and
	  battery life through intelligent task management.

	  If unsure, say Y.

config AI_SCHEDULER_DEBUG
	bool "AI Scheduler Debug Support"
	depends on AI_SCHEDULER && DEBUG_KERNEL
	default n
	help
	  Enable debug support for the AI scheduler. This includes
	  detailed logging, statistics collection, and debugging
	  interfaces.

	  This option increases kernel size and may impact performance.
	  Only enable for development and debugging purposes.

	  If unsure, say N.

config AI_SCHEDULER_STATS
	bool "AI Scheduler Statistics"
	depends on AI_SCHEDULER
	default y
	help
	  Enable statistics collection for the AI scheduler. This
	  provides detailed performance metrics and learning progress
	  information through /proc and sysfs interfaces.

	  The statistics help monitor AI scheduler effectiveness and
	  can be used for performance tuning.

	  If unsure, say Y.

config AI_SCHEDULER_LEARNING_RATE
	int "AI Learning Rate (1-1000)"
	depends on AI_SCHEDULER
	range 1 1000
	default 100
	help
	  Set the learning rate for the AI scheduler's machine learning
	  algorithm. Higher values make the system learn faster but may
	  be less stable. Lower values are more stable but learn slower.

	  Recommended values:
	  - 50-100: Conservative learning (stable)
	  - 100-200: Balanced learning (default)
	  - 200-500: Aggressive learning (fast adaptation)

	  Default: 100

config AI_SCHEDULER_MAX_HISTORY
	int "Maximum History Entries per Task"
	depends on AI_SCHEDULER
	range 10 1000
	default 100
	help
	  Maximum number of historical data points to keep per task
	  for learning purposes. Higher values provide more learning
	  data but use more memory.

	  Each entry uses approximately 200 bytes of memory.

	  Default: 100 (about 20KB per task)

config AI_GPU_ACCELERATION
	tristate "AI GPU Acceleration Framework"
	depends on AI_SUBSYSTEM && DRM
	default m
	help
	  Enable AI-powered GPU acceleration that optimizes graphics
	  performance based on workload detection and user patterns.

	  Features include:
	  - Automatic gaming detection and optimization
	  - AI/ML workload acceleration
	  - Dynamic frequency scaling
	  - Thermal-aware performance management

	  This is particularly beneficial for gaming and AI applications.

	  If unsure, say M.

config AI_POWER_MANAGEMENT
	tristate "AI Power Management"
	depends on AI_SUBSYSTEM && PM
	default m
	help
	  Enable AI-powered power management that learns from usage
	  patterns to optimize battery life and thermal performance.

	  Features include:
	  - Battery life prediction
	  - Adaptive thermal management
	  - Usage pattern learning
	  - Intelligent power scaling

	  This can significantly improve battery life through smart
	  power management decisions.

	  If unsure, say M.

config AI_SECURITY
	tristate "AI Security Framework"
	depends on AI_SUBSYSTEM && SECURITY
	default m
	help
	  Enable AI-powered security features that detect and prevent
	  threats using behavioral analysis and machine learning.

	  Features include:
	  - Real-time threat detection
	  - Behavioral anomaly detection
	  - Malware pattern recognition
	  - Automated threat response

	  This provides advanced protection against sophisticated
	  attacks and zero-day exploits.

	  If unsure, say M.

config AI_NETWORK_OPTIMIZATION
	tristate "AI Network Optimization"
	depends on AI_SUBSYSTEM && NET
	default m
	help
	  Enable AI-powered network optimization that automatically
	  selects optimal protocols and configurations based on
	  network conditions and application requirements.

	  Features include:
	  - Intelligent protocol selection
	  - Latency optimization for gaming
	  - Bandwidth prediction and allocation
	  - Connection quality optimization

	  This can improve network performance and reduce latency
	  for interactive applications.

	  If unsure, say M.

endif # AI_SUBSYSTEM